# PaperFlow Configuration
BRAND_NAME=PaperFlow
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage & Job Retention
STORAGE_PATH=./backend/data/storage
TEMP_DIR=./backend/data/temp
MAX_FILE_SIZE_MB=50
MAX_BATCH_FILES=30
JOB_RETENTION_MINUTES=60
CLEANUP_INTERVAL_MINUTES=15

# System Binaries Path (Optional overrides)
GHOSTSCRIPT_PATH=
TESSERACT_PATH=
LIBREOFFICE_PATH=
QPDF_PATH=

# AI Provider Settings (Optional server-side keys)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string
ENABLE_CORS=true
